<h2>Timesheet Portal</h2>

<div class="entity-container">
  <div class="entity-col">
    <div class="entity">
      <div class="entity-name">Signed-in User</div>

      <div class="key-value">
        <div class="field-content">
          <div class="field-label">Name</div>
          <div class="field-value"><%= user.DisplayName %></div>
        </div>
      </div>

      <div class="key-value">
        <div class="field-content">
          <div class="field-label">Email</div>
          <div class="field-value"><%= user.Email %></div>
        </div>
      </div>

      <div class="key-value">
        <div class="field-content">
          <div class="field-label">Role</div>
          <div class="field-value domain-field"><%= user.Role %></div>
        </div>
      </div>

      <div class="key-value">
        <div class="field-content">
          <div class="field-label">Team</div>
          <div class="field-value"><%= user.TeamName || '-' %></div>
        </div>
      </div>

      <div class="key-value">
        <div class="field-content">
          <div class="field-label">SubTeam</div>
          <div class="field-value"><%= user.SubTeamName || '-' %></div>
        </div>
      </div>

    </div>

    <div class="entity">
      <div class="entity-name">Quick Links</div>
      <div class="filter-container">
        <% if (user.Role === 'Vendor') { %>
          <a href="/timesheets">My Timesheets</a>
        <% } %>

        <% if (user.Role === 'Approver' || user.Role === 'Admin') { %>
          <a href="/approvals">Approvals</a>
        <% } %>

        <% if (user.Role === 'Admin') { %>
          <a href="/admin/projects">Admin</a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="entity-col">
    <div class="entity">
      <div class="entity-name">How it works</div>
      <div class="field-value">
        <ul style="margin-left:18px; line-height:1.6;">
          <li>Vendor enters <b>one row per day</b>.</li>
          <li>Approvers are linked to <b>Project Name</b>.</li>
          <li>When submitted, approvals are created per distinct project used.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
