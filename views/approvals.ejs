<h2>Pending Approvals</h2>

<div class="entity">
  <div class="entity-name">Approvals Queue</div>

  <table class="diff-table">
    <thead>
      <tr>
        <th>Week Ending</th>
        <th>Vendor</th>
        <th>Project</th>
        <th>Timesheet Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows || rows.length === 0) { %>
        <tr><td colspan="5" class="muted">No pending approvals.</td></tr>
      <% } %>

      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.WeekEndingDate.toISOString().slice(0,10) %></td>
          <td><%= r.VendorName %> (<%= r.VendorEmail %>)</td>
          <td><%= r.ProjectName %></td>
          <td><span class="pill"><%= r.TimesheetStatus %></span></td>
          <td>
            <button
              type="button"
              class="btn-primary btn-review"
              data-approval-id="<%= r.ApprovalId %>">
              Review
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".btn-review");
    if (!btn) return;

    const approvalId = Number(btn.dataset.approvalId);

    if (!Number.isInteger(approvalId) || approvalId <= 0) {
      alert("Invalid ApprovalId on button: " + btn.dataset.approvalId);
      return;
    }

    // ✅ Navigate using approvalId only (clean & correct)
    window.location.href = `/approvals/${approvalId}/view`;
  });
</script>
