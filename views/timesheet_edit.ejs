<h2>
  Timesheet - Week Ending <%= weekEnding %>
  <span class="pill"><%= status %></span>
</h2>

<% if (typeof error !== "undefined" && error) { %>
  <div id="validationAlert" class="alert alert-error">
    <div class="alert-title">⚠️ Validation Error</div>
    <div class="alert-body">
      <%- String(error).replace(/\n/g, "<br/>") %>
    </div>
  </div>
<% } %>
<div id="saveSuccessAlert" class="alert alert-success" style="display:none;">
  <div class="alert-title">✅ Saved</div>
  <div class="alert-body">Your timesheet draft has been saved.</div>
</div>

<div id="validationBox" class="validation-box" style="display:none;"></div>

<div class="entity">
  <div class="entity-name">Entry (One row per day)</div>

  <table class="diff-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Day</th>
        <th>Project</th>
        <th>Work Summary</th>
        <th>ADO Ticket(s)</th>
        <th>Hours</th>
      </tr>
    </thead>

    <tbody>
      <% days.forEach((d, idx) => { %>
        <tr>
          <td><%= (d.WorkDate instanceof Date ? d.WorkDate.toISOString().slice(0,10) : d.WorkDate) %></td>
          <td><%= d.DayName %></td>

          <% if (typeof approvalView !== "undefined" && approvalView) { %>
            <td><%= d.ProjectName || "" %></td>
            <td><%= d.WorkSummary || "" %></td>
            <td><%= d.ADOTickets || "" %></td>
            <td><%= d.Hours %></td>
          <% } else { %>

            <td>
              <select class="input project-select">
                <option value="">-- Select Project --</option>
                <% (projects || []).forEach(p => { %>
                  <option
                    value="<%= p.ProjectName %>"
                    <%= (String(d.ProjectName || "") === String(p.ProjectName) ? "selected" : "") %>
                  >
                    <%= p.ProjectName %>
                  </option>
                <% }) %>
              </select>
            </td>

            <td><input class="input work-summary" type="text" value="<%= d.WorkSummary || '' %>"></td>
            <td><input class="input ado-tickets" type="text" value="<%= d.ADOTickets || '' %>"></td>
            <td><input class="input hours" type="number" step="0.25" min="0" max="24" value="<%= d.Hours %>"></td>

          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (!(typeof approvalView !== "undefined" && approvalView)) { %>
    <div class="filter-container" style="margin-top:16px;">
      <button class="btn-secondary" type="button" onclick="save()">Save Draft</button>

      <button id="btnSubmit" class="btn-primary" type="button" onclick="submitTimesheet(<%= timesheetId %>)">
        Submit
      </button>


      <a href="/timesheets" class="back-link">Back</a>
    </div>

    <script>


      function clearValidationAlert() {
        const el = document.getElementById("validationAlert");
        if (el) el.style.display = "none";
      }

      function showSaveSuccess(message) {
          const el = document.getElementById("saveSuccessAlert");
          if (!el) return;

          const body = el.querySelector(".alert-body");
          if (body) body.textContent = message || "Your timesheet draft has been saved.";

          el.style.display = "block";

          // auto-hide after 3 seconds
          window.clearTimeout(window.__saveSuccessTimer);
          window.__saveSuccessTimer = window.setTimeout(() => {
            el.style.display = "none";
          }, 3000);
      }

      function isWeekendDayName(dayName) {
        const d = String(dayName || "").toLowerCase();
        return d.startsWith("sat") || d.startsWith("sun");
      }

      function autoFillWeekends() {
        const trs = document.querySelectorAll("tbody tr");

        for (const tr of trs) {
          const dayName = tr.children[1]?.textContent?.trim(); // column 2 = Day
          if (!isWeekendDayName(dayName)) continue;

          const projectSel = tr.querySelector(".project-select");
          const summaryInp = tr.querySelector(".work-summary");
          const adoInp = tr.querySelector(".ado-tickets");
          const hoursInp = tr.querySelector(".hours");

          // Only autofill if user hasn’t already entered something
          if (projectSel && !projectSel.value) projectSel.value = "Non-Working";
          if (summaryInp && !summaryInp.value) summaryInp.value = "Weekend";
          if (hoursInp && (hoursInp.value === "" || hoursInp.value == null)) hoursInp.value = "0";

          // Recommended: fill ADO for weekends so submit rule "all fields required" passes
          if (adoInp && !adoInp.value) adoInp.value = "N/A";
        }
      }

      document.addEventListener("DOMContentLoaded", autoFillWeekends);

      function collectRowsFromUI() {
        const trs = document.querySelectorAll("tbody tr");
        const ids = <%- JSON.stringify(days.map(x => x.TimesheetDayId)) %>;
        const rows = [];

        for (let i = 0; i < trs.length; i++) {
          const tr = trs[i];
          rows.push({
            timesheetDayId: ids[i],
            dayName: tr.children[1]?.textContent?.trim() || "", // for weekend rule
            projectName: tr.querySelector(".project-select")?.value || "",
            workSummary: tr.querySelector(".work-summary")?.value || "",
            adoTickets: tr.querySelector(".ado-tickets")?.value || "",
            hours: tr.querySelector(".hours")?.value || ""
          });
        }
        return rows;
      }

      function validateRowsClient(rows) {
        const errors = [];

        function isWeekend(dayName) {
          const d = String(dayName || "").toLowerCase();
          return d.startsWith("sat") || d.startsWith("sun");
        }

        rows.forEach((r, idx) => {
          const rowLabel = `Row ${idx + 1} (${r.dayName || "Day"})`;

          const project = String(r.projectName || "").trim();
          const summary = String(r.workSummary || "").trim();
          const ado = String(r.adoTickets || "").trim();
          const hours = Number(r.hours);

          if (!project) errors.push(`${rowLabel}: Project is required.`);
          if (!summary) errors.push(`${rowLabel}: Work Summary is required.`);
          if (!ado) errors.push(`${rowLabel}: ADO Ticket is required.`);

          if (!Number.isFinite(hours)) {
            errors.push(`${rowLabel}: Hours must be a number.`);
          } else if (isWeekend(r.dayName)) {
            if (hours < 0) errors.push(`${rowLabel}: Hours cannot be negative.`);
            // weekend allows 0
          } else {
            if (hours <= 0) errors.push(`${rowLabel}: Hours must be greater than 0 (weekdays).`);
          }
        });

        return errors;
      }

    function clearValidationErrorsUI() {
      const box = document.getElementById("validationBox");
      if (box) {
        box.style.display = "none";
        box.innerHTML = "";
      }

      document.querySelectorAll("tbody tr").forEach(tr => {
        tr.classList.remove("row-error");
        tr.querySelectorAll(".field-error").forEach(el => el.classList.remove("field-error"));
      });
    }

    function showValidationErrors(errors) {
      const box = document.getElementById("validationBox");

      // Fallback if container missing
      if (!box) {
        alert(Array.isArray(errors) ? errors.join("\n") : String(errors));
        return;
      }

      // Display panel
      const list = (Array.isArray(errors) ? errors : [String(errors)])
        .map(e => `<li>${escapeHtml(e)}</li>`)
        .join("");

      box.innerHTML = `
        <div><b>Please fix the following before submitting:</b></div>
        <ul>${list}</ul>
      `;
      box.style.display = "block";
      box.scrollIntoView({ behavior: "smooth", block: "start" });

      // Highlight rows based on error text like: "Row 3 (Mon): Project is required."
      const trs = Array.from(document.querySelectorAll("tbody tr"));

      for (const msg of (Array.isArray(errors) ? errors : [String(errors)])) {
        const m = msg.match(/^Row\s+(\d+)\s+\(([^)]+)\):\s*(.*)$/i);
        if (!m) continue;

        const rowNum = Number(m[1]);   // your message is 1-based
        const rowIndex = rowNum - 1;   // convert to 0-based
        const detail = (m[3] || "").toLowerCase();

        const tr = trs[rowIndex];
        if (!tr) continue;

        tr.classList.add("row-error");

        // Optional: highlight specific field if we can infer it
        if (detail.includes("project")) tr.querySelector(".project-select")?.classList.add("field-error");
        if (detail.includes("work summary")) tr.querySelector(".work-summary")?.classList.add("field-error");
        if (detail.includes("ado")) tr.querySelector(".ado-tickets")?.classList.add("field-error");
        if (detail.includes("hours")) tr.querySelector(".hours")?.classList.add("field-error");
      }
    }

    // Simple HTML escape to avoid rendering issues
    function escapeHtml(s) {
      return String(s)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    document.addEventListener("input", (e) => {
      if (e.target.closest("tbody")) clearValidationErrorsUI();
    });

    document.addEventListener("change", (e) => {
      if (e.target.closest("tbody")) clearValidationErrorsUI();
    });

    async function submitTimesheet() {
          // ---- UI helpers (safe even if elements missing) ----
          function getValidationBox() {
            return document.getElementById("validationBox");
          }

          function clearValidationUI() {
            const box = getValidationBox();
            if (box) {
              box.style.display = "none";
              box.innerHTML = "";
            }

            document.querySelectorAll("tbody tr").forEach(tr => {
              tr.classList.remove("row-error");
              tr.querySelectorAll(".field-error").forEach(el => el.classList.remove("field-error"));
            });
          }

          function escapeHtml(s) {
            return String(s)
              .replaceAll("&", "&amp;")
              .replaceAll("<", "&lt;")
              .replaceAll(">", "&gt;")
              .replaceAll('"', "&quot;")
              .replaceAll("'", "&#039;");
          }

          function showValidationErrorsUI(errors) {
            const msgs = Array.isArray(errors) ? errors : [String(errors)];
            const box = getValidationBox();

            // Render panel
            if (box) {
              box.innerHTML = `
                <div><b>Please fix the following before submitting:</b></div>
                <ul>${msgs.map(m => `<li>${escapeHtml(m)}</li>`).join("")}</ul>
              `;
              box.style.display = "block";
              box.scrollIntoView({ behavior: "smooth", block: "start" });
            } else {
              // fallback
              console.warn("validationBox not found; falling back to console.");
              console.warn(msgs);
            }

            // Highlight rows/fields based on your error format:
            // "Row 3 (Mon): Project is required."
            const trs = Array.from(document.querySelectorAll("tbody tr"));

            for (const msg of msgs) {
              const m = msg.match(/^Row\s+(\d+)\s+\(([^)]+)\):\s*(.*)$/i);
              if (!m) continue;

              const rowNum = Number(m[1]);        // 1-based
              const idx = rowNum - 1;             // 0-based
              const detail = (m[3] || "").toLowerCase();

              const tr = trs[idx];
              if (!tr) continue;

              tr.classList.add("row-error");

              // Field-level highlighting (based on text)
              if (detail.includes("project")) tr.querySelector(".project-select")?.classList.add("field-error");
              if (detail.includes("work summary")) tr.querySelector(".work-summary")?.classList.add("field-error");
              if (detail.includes("ado")) tr.querySelector(".ado-tickets")?.classList.add("field-error");
              if (detail.includes("hours")) tr.querySelector(".hours")?.classList.add("field-error");
            }
          }

          // ---- start submit ----
          clearValidationUI();

          const submitBtn = document.getElementById("btnSubmit");
          if (submitBtn) submitBtn.disabled = true;

          try {
            // Ensure weekends are auto-filled before validate & submit
            autoFillWeekends();

            const rows = collectRowsFromUI();

            // Ensure dayName exists for server weekend rule + your validator
            const trs = document.querySelectorAll("tbody tr");
            for (let i = 0; i < trs.length; i++) {
              rows[i].dayName = trs[i].children[1]?.textContent?.trim() || "";
            }

            const errors = validateRowsClient(rows);
            if (errors.length) {
              showValidationErrorsUI(errors);
              return;
            }

            const url = `/timesheets/<%= timesheetId %>/submit`;

            // Timeout protection (15s)
            const controller = new AbortController();
            const t = setTimeout(() => controller.abort(), 15000);

            const resp = await fetch(url, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify({ weekEnding: "<%= weekEnding %>", rows }),
              signal: controller.signal
            });

            clearTimeout(t);

            const ct = resp.headers.get("content-type") || "";
            const raw = await resp.text();

            if (!resp.ok) {
              let msg = "Submit failed.";
              if (ct.includes("application/json")) {
                try { msg = (JSON.parse(raw)?.message) || msg; } catch {}
              } else {
                msg = raw || msg;
              }
              showValidationErrorsUI([msg]);
              return;
            }

            // Success
            window.location.href = "/timesheets";

          } catch (err) {
            const msg =
              err?.name === "AbortError"
                ? "Submit timed out. Please try again (server may be busy)."
                : (err?.message || String(err));

            showValidationErrorsUI([msg]);
            console.error("submitTimesheet error:", err);
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        }

      
      function save() {
        const trs = document.querySelectorAll("tbody tr");
        const ids = <%- JSON.stringify(days.map(x => x.TimesheetDayId)) %>;
        const rows = [];

        for (let i = 0; i < trs.length; i++) {
          const tr = trs[i];

          const project = tr.querySelector(".project-select")?.value || "";
          const workSummary = tr.querySelector(".work-summary")?.value || "";
          const adoTickets = tr.querySelector(".ado-tickets")?.value || "";
          const hours = tr.querySelector(".hours")?.value || "";

          rows.push({
            timesheetDayId: ids[i],
            projectName: project,
            workSummary: workSummary,
            adoTickets: adoTickets,
            hours: hours
          });
        }

        fetch(`/timesheets/<%= timesheetId %>/save`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ weekEnding: "<%= weekEnding %>", rows })
        }).then(async (r) => {
          if (!r.ok) {
            const j = await r.json().catch(() => null);
            alert(j?.message || "Save failed");
            return;
          }


          // ✅ After a successful save draft, hide the submit validation error
          clearValidationAlert();

           // ✅ show success confirmation
          showSaveSuccess("Saved successfully.");

        });
      }
    </script>
  <% } else { %>
    <div class="filter-container" style="margin-top:16px;">
      <form method="post" action="/approvals/<%= approvalId %>/approve" class="inline-form">
        <button class="btn-primary" type="submit">Approve</button>
      </form>

      <form method="post" action="/approvals/<%= approvalId %>/reject" class="inline-form">
        <input name="comment" placeholder="Rejection comment (required)" style="min-width:320px"/>
        <button class="btn-danger" type="submit">Reject</button>
      </form>

      <a href="/approvals" class="back-link">Back</a>
    </div>
  <% } %>
</div>
