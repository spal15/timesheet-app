<h2>
  Timesheet - Week Ending <%= weekEnding %>
  <span class="pill"><%= status %></span>
</h2>

<%
  const _comment = (typeof comment !== 'undefined') ? comment : null;
  const _vendorReply = (typeof vendorReply !== 'undefined') ? vendorReply : null;
  const _vendorReplyAt = (typeof vendorReplyAt !== 'undefined') ? vendorReplyAt : null;
  const _approvalView = (typeof approvalView !== "undefined" && approvalView);
  const _maxEntriesPerDay = Number(typeof maxEntriesPerDay !== "undefined" ? maxEntriesPerDay : 5);

  const rp =
    (typeof rejectedProjects !== "undefined" && Array.isArray(rejectedProjects))
      ? rejectedProjects
      : [];

  const hasVendorReply = rp.some(r => String((r && r.VendorReply) || "").trim().length > 0);

  function fmtDate(v) {
    if (!v) return "";
    try {
      if (v instanceof Date) return v.toISOString().slice(0, 10);
      return String(v).slice(0, 10);
    } catch {
      return String(v || "");
    }
  }

  function isWeekendName(dayName) {
    return String(dayName || "").toLowerCase().startsWith("sat") ||
           String(dayName || "").toLowerCase().startsWith("sun");
  }

  function normalizeEntriesForView(day) {
    if (Array.isArray(day.entries) && day.entries.length) return day.entries;

    if (_approvalView) {
      return [{
        entryId: null,
        entryOrder: 1,
        projectName: day.ProjectName || "",
        workSummary: day.WorkSummary || "",
        adoTickets: day.ADOTickets || "",
        hours: day.Hours ?? ""
      }];
    }

    if (isWeekendName(day.DayName)) {
      return [{
        entryId: null,
        entryOrder: 1,
        projectName: "Non-Working",
        workSummary: "Weekend",
        adoTickets: "N/A",
        hours: 0
      }];
    }

    return [{
      entryId: null,
      entryOrder: 1,
      projectName: day.ProjectName || "",
      workSummary: day.WorkSummary || "",
      adoTickets: day.ADOTickets || "",
      hours: day.Hours ?? ""
    }];
  }

  const daysForView = (Array.isArray(days) ? days : []).map(d => ({
    ...d,
    entries: normalizeEntriesForView(d)
  }));
%>

<% if (_comment || _vendorReply) { %>
  <div class="approval-conversation-card">
    <% if (_comment) { %>
      <div class="approver-comment">
        <div class="label">Approver Comment</div>
        <div class="message"><%= _comment %></div>
      </div>
    <% } %>

    <% if (_vendorReply) { %>
      <div class="vendor-reply">
        <div class="label">Vendor Reply</div>
        <div class="message"><%= _vendorReply %></div>
        <% if (_vendorReplyAt) { %>
          <div class="timestamp"><%= new Date(_vendorReplyAt).toLocaleString() %></div>
        <% } %>
      </div>
    <% } %>
  </div>
<% } %>

<% if (hasVendorReply || (status === "Rejected" && rp.length)) { %>
  <div class="alert alert-error" style="margin-top:12px; cursor:pointer;" onclick="toggleRejectDetails()">
    <div class="alert-title" style="display:flex; align-items:center; justify-content:space-between;">
      <span>❌ Rejected <span style="font-weight:normal;">(click to expand)</span></span>
      <span id="rejectChevron" aria-hidden="true">▸</span>
    </div>

    <div id="rejectDetails" class="alert-body" style="display:none; margin-top:8px; cursor:default;" onclick="event.stopPropagation()">
      <div style="margin-bottom:6px;"><b>Rejection details by project:</b></div>

      <ul style="margin:0; padding-left:18px;">
        <% rp.forEach(r => { %>
          <li style="margin-bottom:14px;">
            <div>
              <b><%= r.ProjectName %>:</b>
              <span><%= r.Comment %></span>
            </div>

            <div style="margin-top:8px; padding-left:2px;">
              <% if (r.VendorReply) { %>
                <div style="margin:6px 0;">
                  <b>Your Reply:</b>
                  <span><%= r.VendorReply %></span>
                  <% if (r.VendorReplyAt) { %>
                    <span style="opacity:0.7; font-size:0.9em;">
                      (sent <%= (r.VendorReplyAt instanceof Date ? r.VendorReplyAt.toISOString().slice(0,19).replace('T',' ') : r.VendorReplyAt) %>)
                    </span>
                  <% } %>
                </div>
              <% } %>

              <textarea
                id="vendorReply-<%= r.TimesheetProjectApprovalId %>"
                class="input"
                rows="2"
                style="width:100%; max-width:720px;"
                placeholder="Reply to approver with details (e.g., updated ADO ticket link, more context, screenshots, etc.)"
              ></textarea>

              <div style="margin-top:6px; display:flex; gap:8px; align-items:center;">
                <button
                  type="button"
                  class="btn-secondary"
                  id="btnSendReply-<%= r.TimesheetProjectApprovalId %>"
                  onclick="sendVendorReply(<%= timesheetId %>, <%= r.TimesheetProjectApprovalId %>)"
                >
                  Send Reply
                </button>

                <span
                  id="replyStatus-<%= r.TimesheetProjectApprovalId %>"
                  style="font-size:0.9em; opacity:0.85;"
                ></span>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <script>
    function toggleRejectDetails() {
      const details = document.getElementById("rejectDetails");
      const chev = document.getElementById("rejectChevron");
      if (!details) return;

      const open = details.style.display !== "none";
      details.style.display = open ? "none" : "block";
      if (chev) chev.textContent = open ? "▸" : "▾";
    }

    async function sendVendorReply(timesheetId, approvalId) {
      const ta = document.getElementById(`vendorReply-${approvalId}`);
      const btn = document.getElementById(`btnSendReply-${approvalId}`);
      const status = document.getElementById(`replyStatus-${approvalId}`);

      const reply = String(ta?.value || "").trim();
      if (!reply) {
        if (status) status.textContent = "Please enter a reply.";
        ta?.focus();
        return;
      }

      if (btn) btn.disabled = true;
      if (status) status.textContent = "Sending...";

      try {
        const resp = await fetch(`/timesheets/${timesheetId}/approvals/${approvalId}/reply`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({ reply })
        });

        const raw = await resp.text();
        const ct = resp.headers.get("content-type") || "";
        let message = "Reply sent.";

        if (!resp.ok) {
          message = raw || "Failed to send reply.";
          if (ct.includes("application/json")) {
            try { message = JSON.parse(raw)?.message || message; } catch {}
          }
          if (status) status.textContent = message;
          return;
        }

        if (ct.includes("application/json")) {
          try { message = JSON.parse(raw)?.message || message; } catch {}
        }

        if (status) status.textContent = message;
        if (ta) ta.value = "";
      } catch (err) {
        if (status) status.textContent = err?.message || "Failed to send reply due to network/server error.";
      } finally {
        if (btn) btn.disabled = false;
      }
    }
  </script>
<% } %>

<% if (typeof error !== "undefined" && error) { %>
  <div id="validationAlert" class="alert alert-error">
    <div class="alert-title">⚠️ Validation Error</div>
    <div class="alert-body">
      <%- String(error).replace(/\n/g, "<br/>") %>
    </div>
  </div>
<% } %>

<div id="saveSuccessAlert" class="alert alert-success" style="display:none;">
  <div class="alert-title">✅ Saved</div>
  <div class="alert-body">Your timesheet draft has been saved.</div>
</div>

<div id="validationBox" class="validation-box" style="display:none;"></div>

<div class="entity">
  <div class="entity-name"><%= _approvalView ? "Review" : "Entry (Up to 5 project rows per day)" %></div>

  <% if (!_approvalView) { %>
    <div style="margin:10px 0 14px 0; font-size:0.95em; opacity:0.9;">
      You can add up to <b><%= _maxEntriesPerDay %></b> project entries per day. Weekend rows stay auto-filled as Non-Working.
    </div>
  <% } %>

  <table class="diff-table" id="timesheetTable">
    <thead>
      <tr>
        <th>Date</th>
        <th>Day</th>
        <th>Project</th>
        <th>Work Summary</th>
        <th>ADO Ticket(s)</th>
        <th>Hours</th>
        <% if (!_approvalView) { %>
          <th style="min-width:140px;">Add Project</th>
          <th style="min-width:120px;">Total</th>
          <th>Action</th>
        <% } %>
      </tr>
    </thead>

    <tbody>
      <% daysForView.forEach((d, dayIdx) => { %>
        <% const entries = d.entries || []; %>
        <% entries.forEach((e, entryIdx) => { %>
          <tr
            data-day-index="<%= dayIdx %>"
            data-day-name="<%= d.DayName %>"
            data-timesheet-day-id="<%= d.TimesheetDayId %>"
            class="<%= entryIdx === 0 ? 'day-first-row' : 'day-extra-row' %>"
          >
            <% if (entryIdx === 0) { %>
              <td rowspan="<%= entries.length %>" class="day-date-cell">
                <%= fmtDate(d.WorkDate) %>
              </td>
              <td rowspan="<%= entries.length %>" class="day-name-cell">
                <%= d.DayName %>
              </td>
            <% } %>

            <% if (_approvalView) { %>
              <td><%= e.projectName || "" %></td>
              <td><%= e.workSummary || "" %></td>
              <td><%= e.adoTickets || "" %></td>
              <td><%= e.hours %></td>
            <% } else { %>
              <td>
                <select class="input project-select">
                  <option value="">-- Select Project --</option>
                  <% (projects || []).forEach(p => { %>
                    <option
                      value="<%= p.ProjectName %>"
                      <%= (String(e.projectName || "") === String(p.ProjectName) ? "selected" : "") %>
                    >
                      <%= p.ProjectName %>
                    </option>
                  <% }) %>
                </select>
              </td>

              <td><input class="input work-summary" type="text" value="<%= e.workSummary || '' %>"></td>
              <td><input class="input ado-tickets" type="text" value="<%= e.adoTickets || '' %>"></td>
              <td><input class="input hours" type="number" step="0.25" min="0" max="24" value="<%= e.hours %>"></td>

              <% if (entryIdx === 0) { %>
                <td rowspan="<%= entries.length %>" class="day-add-project-cell" style="vertical-align:top;">
                  <button
                    type="button"
                    class="btn-secondary btn-add-project"
                    onclick="addProjectRow(<%= dayIdx %>)"
                  >
                    + Add Project
                  </button>
                </td>

                <td rowspan="<%= entries.length %>" class="day-total-cell" data-day-total-for="<%= dayIdx %>" style="vertical-align:top; font-weight:600; white-space:nowrap;">
                  Day Total: <span class="day-total-value">0.00</span>
                </td>
              <% } %>

              <td>
                <button type="button" class="btn-danger btn-remove-project" onclick="removeProjectRow(this)">Remove</button>
              </td>
            <% } %>
          </tr>
        <% }) %>
      <% }) %>
    </tbody>
  </table>

  <% if (!_approvalView) { %>
    <div class="filter-container" style="margin-top:16px;">
      <button class="btn-secondary" type="button" onclick="save()">Save Draft</button>

      <button id="btnSubmit" class="btn-primary" type="button" onclick="submitTimesheet()">
        Submit
      </button>

      <a href="/timesheets" class="back-link">Back</a>
    </div>

    <template id="projectRowTemplate">
      <tr data-day-index="" data-day-name="" data-timesheet-day-id="" class="day-extra-row">
        <td>
          <select class="input project-select">
            <option value="">-- Select Project --</option>
            <% (projects || []).forEach(p => { %>
              <option value="<%= p.ProjectName %>"><%= p.ProjectName %></option>
            <% }) %>
          </select>
        </td>
        <td><input class="input work-summary" type="text" value=""></td>
        <td><input class="input ado-tickets" type="text" value=""></td>
        <td><input class="input hours" type="number" step="0.25" min="0" max="24" value=""></td>
        <td><button type="button" class="btn-danger btn-remove-project" onclick="removeProjectRow(this)">Remove</button></td>
      </tr>
    </template>

    <script>
      const TIMESHEET_ID = <%= timesheetId %>;
      const WEEK_ENDING = "<%= weekEnding %>";
      const MAX_ENTRIES_PER_DAY = <%= _maxEntriesPerDay %>;

      function clearValidationAlert() {
        const el = document.getElementById("validationAlert");
        if (el) el.style.display = "none";
      }

      function showSaveSuccess(message) {
        const el = document.getElementById("saveSuccessAlert");
        if (!el) return;

        const body = el.querySelector(".alert-body");
        if (body) body.textContent = message || "Your timesheet draft has been saved.";

        el.style.display = "block";
        window.clearTimeout(window.__saveSuccessTimer);
        window.__saveSuccessTimer = window.setTimeout(() => {
          el.style.display = "none";
        }, 3000);
      }

      function escapeHtml(s) {
        return String(s)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function isWeekendDayName(dayName) {
        const d = String(dayName || "").toLowerCase();
        return d.startsWith("sat") || d.startsWith("sun");
      }

      function getDayRows(dayIndex) {
        return Array.from(document.querySelectorAll(`tr[data-day-index="${dayIndex}"]`));
      }

      function getDateCell(dayIndex) {
        return document.querySelector(`tr[data-day-index="${dayIndex}"] .day-date-cell`);
      }

      function getDayNameCell(dayIndex) {
        return document.querySelector(`tr[data-day-index="${dayIndex}"] .day-name-cell`);
      }

      function getDayAddProjectCell(dayIndex) {
        return document.querySelector(`tr[data-day-index="${dayIndex}"] .day-add-project-cell`);
      }

      function getDayTotalCell(dayIndex) {
        return document.querySelector(`tr[data-day-index="${dayIndex}"] .day-total-cell`);
      }

      function updateDayRowspans(dayIndex) {
        const rows = getDayRows(dayIndex);
        const dateCell = getDateCell(dayIndex);
        const dayCell = getDayNameCell(dayIndex);
        const addProjectCell = getDayAddProjectCell(dayIndex);
        const totalCell = getDayTotalCell(dayIndex);
        const spanCount = Math.max(rows.length, 1);

        if (dateCell) dateCell.rowSpan = spanCount;
        if (dayCell) dayCell.rowSpan = spanCount;
        if (addProjectCell) addProjectCell.rowSpan = spanCount;
        if (totalCell) totalCell.rowSpan = spanCount;

        const addBtn = addProjectCell?.querySelector(".btn-add-project");
        if (addBtn) addBtn.disabled = rows.length >= MAX_ENTRIES_PER_DAY;
      }

      function updateDayTotals() {
        const totalCells = Array.from(document.querySelectorAll(".day-total-cell"));

        for (const cell of totalCells) {
          const dayIndex = cell.getAttribute("data-day-total-for");
          const rows = getDayRows(dayIndex);
          let sum = 0;

          for (const row of rows) {
            const hoursInput = row.querySelector(".hours");
            const h = Number(hoursInput?.value || 0);
            if (Number.isFinite(h)) sum += h;
          }

          const span = cell.querySelector(".day-total-value");
          if (span) span.textContent = sum.toFixed(2);
        }
      }

      function autoFillWeekends() {
        const rows = Array.from(document.querySelectorAll('tr[data-day-index]'));

        for (const tr of rows) {
          const dayName = tr.getAttribute("data-day-name") || "";
          if (!isWeekendDayName(dayName)) continue;

          const projectSel = tr.querySelector(".project-select");
          const summaryInp = tr.querySelector(".work-summary");
          const adoInp = tr.querySelector(".ado-tickets");
          const hoursInp = tr.querySelector(".hours");

          const currentProject = String(projectSel?.value || "").trim();
          const normalizedProject = currentProject.toLowerCase();

          if (!currentProject) {
            if (projectSel) projectSel.value = "Non-Working";
            if (summaryInp && !String(summaryInp.value || "").trim()) summaryInp.value = "Weekend";
            if (adoInp && !String(adoInp.value || "").trim()) adoInp.value = "N/A";
            if (hoursInp && String(hoursInp.value || "").trim() === "") hoursInp.value = "0";
            continue;
          }

          if (normalizedProject === "non-working" || normalizedProject === "non working") {
            if (summaryInp && !String(summaryInp.value || "").trim()) summaryInp.value = "Weekend";
            if (adoInp && !String(adoInp.value || "").trim()) adoInp.value = "N/A";
            if (hoursInp && String(hoursInp.value || "").trim() === "") hoursInp.value = "0";
          }
        }
      }

      function addProjectRow(dayIndex) {
        const rows = getDayRows(dayIndex);
        if (rows.length >= MAX_ENTRIES_PER_DAY) {
          showValidationErrors([`Maximum ${MAX_ENTRIES_PER_DAY} entries allowed for this day.`]);
          return;
        }

        const lastRow = rows[rows.length - 1];
        const template = document.getElementById("projectRowTemplate");
        if (!template || !lastRow) return;

        const frag = template.content.cloneNode(true);
        const newRow = frag.querySelector("tr");

        newRow.setAttribute("data-day-index", lastRow.getAttribute("data-day-index") || "");
        newRow.setAttribute("data-day-name", lastRow.getAttribute("data-day-name") || "");
        newRow.setAttribute("data-timesheet-day-id", lastRow.getAttribute("data-timesheet-day-id") || "");

        lastRow.parentNode.insertBefore(newRow, lastRow.nextSibling);

        updateDayRowspans(dayIndex);
        updateDayTotals();
      }

      function removeProjectRow(btn) {
        const tr = btn.closest("tr");
        if (!tr) return;

        const dayIndex = tr.getAttribute("data-day-index");
        const rows = getDayRows(dayIndex);

        if (rows.length <= 1) {
          showValidationErrors(["At least one row is required for each day."]);
          return;
        }

        const firstRow = rows[0];
        const isFirstRow = firstRow === tr;

        if (isFirstRow && rows.length > 1) {
          const nextRow = rows[1];
          const dateCell = tr.querySelector(".day-date-cell");
          const dayCell = tr.querySelector(".day-name-cell");
          const addProjectCell = tr.querySelector(".day-add-project-cell");
          const totalCell = tr.querySelector(".day-total-cell");

          if (dateCell) nextRow.insertBefore(dateCell, nextRow.firstChild);
          if (dayCell) nextRow.insertBefore(dayCell, nextRow.children[1] || null);
          if (addProjectCell) nextRow.insertBefore(addProjectCell, nextRow.children[6] || null);
          if (totalCell) nextRow.insertBefore(totalCell, nextRow.children[7] || null);
        }

        tr.remove();
        updateDayRowspans(dayIndex);
        updateDayTotals();
      }

      function collectDaysFromUI() {
        const dayMap = new Map();
        const trs = Array.from(document.querySelectorAll('tr[data-day-index]'));

        for (const tr of trs) {
          const dayIndex = tr.getAttribute("data-day-index");
          const timesheetDayId = Number(tr.getAttribute("data-timesheet-day-id"));
          const dayName = tr.getAttribute("data-day-name") || "";

          if (!dayMap.has(dayIndex)) {
            dayMap.set(dayIndex, {
              timesheetDayId,
              dayName,
              entries: []
            });
          }

          dayMap.get(dayIndex).entries.push({
            projectName: tr.querySelector(".project-select")?.value || "",
            workSummary: tr.querySelector(".work-summary")?.value || "",
            adoTickets: tr.querySelector(".ado-tickets")?.value || "",
            hours: tr.querySelector(".hours")?.value || ""
          });
        }

        return Array.from(dayMap.entries())
          .sort((a, b) => Number(a[0]) - Number(b[0]))
          .map(x => x[1]);
      }

      function validateDaysClient(days) {
        const errors = [];
        let weekTotal = 0;

        days.forEach((day, dayIdx) => {
          const dayLabel = `Day ${dayIdx + 1} (${day.dayName || "Day"})`;
          const weekend = isWeekendDayName(day.dayName);
          const entries = Array.isArray(day.entries) ? day.entries : [];

          if (entries.length === 0) {
            errors.push(`${dayLabel}: At least one entry is required.`);
            return;
          }

          if (entries.length > MAX_ENTRIES_PER_DAY) {
            errors.push(`${dayLabel}: Maximum ${MAX_ENTRIES_PER_DAY} entries allowed.`);
          }

          let dayTotal = 0;

          entries.forEach((e, entryIdx) => {
            const rowLabel = `${dayLabel} - Entry ${entryIdx + 1}`;
            const project = String(e.projectName || "").trim();
            const summary = String(e.workSummary || "").trim();
            const ado = String(e.adoTickets || "").trim();
            const hours = Number(e.hours);

            if (!project) errors.push(`${rowLabel}: Project is required.`);
            if (!summary) errors.push(`${rowLabel}: Work Summary is required.`);
            //if (!ado) errors.push(`${rowLabel}: ADO Ticket is required.`);

            if (!Number.isFinite(hours)) {
              errors.push(`${rowLabel}: Hours must be a number.`);
            } else {
              const isNonWorking = project.toLowerCase() === "non-working" || project.toLowerCase() === "non working";

              if (isNonWorking) {
                if (hours !== 0) errors.push(`${rowLabel}: Non-Working hours must be 0.`);
              } else {
                if (hours <= 0) errors.push(`${rowLabel}: Hours must be greater than 0.`);
              }

              dayTotal += hours;
            }
          });

          if (dayTotal > 15) {
            errors.push(`${dayLabel}: Total hours cannot exceed 15.`);
          }

          weekTotal += dayTotal;
        });

        if (weekTotal > 70) {
          errors.push(`Total weekly hours (${weekTotal}) cannot exceed 70.`);
        }

        return errors;
      }

      function clearValidationErrorsUI() {
        const box = document.getElementById("validationBox");
        if (box) {
          box.style.display = "none";
          box.innerHTML = "";
        }

        document.querySelectorAll("tr[data-day-index]").forEach(tr => {
          tr.classList.remove("row-error");
          tr.querySelectorAll(".field-error").forEach(el => el.classList.remove("field-error"));
        });
      }

      function showValidationErrors(errors) {
        const box = document.getElementById("validationBox");
        const msgs = Array.isArray(errors) ? errors : [String(errors)];

        if (!box) {
          alert(msgs.join("\n"));
          return;
        }

        box.innerHTML = `
          <div><b>Please fix the following before submitting:</b></div>
          <ul>${msgs.map(e => `<li>${escapeHtml(e)}</li>`).join("")}</ul>
        `;
        box.style.display = "block";
        box.scrollIntoView({ behavior: "smooth", block: "start" });

        const trs = Array.from(document.querySelectorAll("tr[data-day-index]"));

        for (const msg of msgs) {
          const m = msg.match(/^Day\s+(\d+)\s+\(([^)]+)\)\s*-\s*Entry\s+(\d+):\s*(.*)$/i);
          if (!m) continue;

          const dayNum = Number(m[1]);
          const entryNum = Number(m[3]);
          const detail = (m[4] || "").toLowerCase();

          const matchingRows = trs.filter(tr => Number(tr.getAttribute("data-day-index")) === (dayNum - 1));
          const tr = matchingRows[entryNum - 1];
          if (!tr) continue;

          tr.classList.add("row-error");

          if (detail.includes("project")) tr.querySelector(".project-select")?.classList.add("field-error");
          if (detail.includes("work summary")) tr.querySelector(".work-summary")?.classList.add("field-error");
          if (detail.includes("ado")) tr.querySelector(".ado-tickets")?.classList.add("field-error");
          if (detail.includes("hours")) tr.querySelector(".hours")?.classList.add("field-error");
        }
      }

      document.addEventListener("input", (e) => {
        if (e.target.closest("tr[data-day-index]")) {
          clearValidationErrorsUI();
          updateDayTotals();
        }
      });

      document.addEventListener("change", (e) => {
        if (e.target.closest("tr[data-day-index]")) {
          clearValidationErrorsUI();
          updateDayTotals();
        }
      });

      async function submitTimesheet() {
        clearValidationErrorsUI();

        const submitBtn = document.getElementById("btnSubmit");
        if (submitBtn) submitBtn.disabled = true;

        try {
          autoFillWeekends();
          const days = collectDaysFromUI();
          const errors = validateDaysClient(days);

          if (errors.length) {
            showValidationErrors(errors);
            return;
          }

          const controller = new AbortController();
          const t = setTimeout(() => controller.abort(), 15000);

          const resp = await fetch(`/timesheets/${TIMESHEET_ID}/submit`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({ weekEnding: WEEK_ENDING, days }),
            signal: controller.signal
          });

          clearTimeout(t);

          const ct = resp.headers.get("content-type") || "";
          const raw = await resp.text();

          if (!resp.ok) {
            let msg = "Submit failed.";
            if (ct.includes("application/json")) {
              try {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed?.errors) && parsed.errors.length) {
                  showValidationErrors(parsed.errors);
                  return;
                }
                msg = parsed?.message || msg;
              } catch {}
            } else {
              msg = raw || msg;
            }
            showValidationErrors([msg]);
            return;
          }

          window.location.href = "/timesheets";
        } catch (err) {
          const msg =
            err?.name === "AbortError"
              ? "Submit timed out. Please try again (server may be busy)."
              : (err?.message || String(err));

          showValidationErrors([msg]);
          console.error("submitTimesheet error:", err);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      }

      async function save() {
        try {
          autoFillWeekends();
          const days = collectDaysFromUI();

          const resp = await fetch(`/timesheets/${TIMESHEET_ID}/save`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({ weekEnding: WEEK_ENDING, days })
          });

          const ct = resp.headers.get("content-type") || "";
          const raw = await resp.text();

          if (!resp.ok) {
            let msg = "Save failed.";
            if (ct.includes("application/json")) {
              try {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed?.errors) && parsed.errors.length) {
                  showValidationErrors(parsed.errors);
                  return;
                }
                msg = parsed?.message || msg;
              } catch {}
            } else {
              msg = raw || msg;
            }
            showValidationErrors([msg]);
            return;
          }

          clearValidationAlert();
          clearValidationErrorsUI();
          showSaveSuccess("Saved successfully.");
        } catch (err) {
          showValidationErrors([err?.message || "Save failed due to network/server error."]);
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        autoFillWeekends();
        const uniqueDayIndexes = [...new Set(Array.from(document.querySelectorAll("tr[data-day-index]")).map(tr => tr.getAttribute("data-day-index")))];
        uniqueDayIndexes.forEach(updateDayRowspans);
        updateDayTotals();
      });
    </script>
  <% } else { %>
    <div class="filter-container" style="margin-top:16px;">
      <form method="post" action="/approvals/<%= approvalId %>/approve" class="inline-form">
        <button class="btn-primary" type="submit">Approve</button>
      </form>

      <form id="rejectForm" class="inline-form" onsubmit="return rejectApproval(event);">
        <input
          id="rejectComment"
          name="comment"
          placeholder="Rejection comment (required)"
          style="min-width:320px"
        />
        <button id="btnReject" class="btn-danger" type="submit">Reject</button>
      </form>

      <a href="/approvals" class="back-link">Back</a>
    </div>

    <script>
      function escapeHtml2(s) {
        return String(s)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function clearApprovalValidationBox() {
        const box = document.getElementById("validationBox");
        if (box) {
          box.style.display = "none";
          box.innerHTML = "";
        }
      }

      function showApprovalError(msg) {
        const box = document.getElementById("validationBox");
        if (!box) {
          alert(msg);
          return;
        }

        box.innerHTML = `
          <div><b>Please fix the following:</b></div>
          <ul><li>${escapeHtml2(msg)}</li></ul>
        `;
        box.style.display = "block";
        box.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      async function rejectApproval(e) {
        e.preventDefault();
        clearApprovalValidationBox();

        const commentEl = document.getElementById("rejectComment");
        const comment = String(commentEl?.value || "").trim();

        if (!comment) {
          showApprovalError("Rejection comment required.");
          commentEl?.focus();
          return false;
        }

        const btn = document.getElementById("btnReject");
        if (btn) btn.disabled = true;

        try {
          const resp = await fetch(`/approvals/<%= approvalId %>/reject`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({ comment })
          });

          const ct = resp.headers.get("content-type") || "";
          const raw = await resp.text();

          if (!resp.ok) {
            let msg = raw || "Reject failed.";
            if (ct.includes("application/json")) {
              try {
                const j = JSON.parse(raw);
                msg = j?.error || j?.message || msg;
              } catch {}
            }
            showApprovalError(msg);
            return false;
          }

          window.location.href = "/approvals";
          return false;
        } catch (err) {
          showApprovalError(err?.message || "Reject failed due to network/server error.");
          return false;
        } finally {
          if (btn) btn.disabled = false;
        }
      }
    </script>
  <% } %>
</div>
